{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stellagaia.local/schemas/personal-local-mode-input-locator.schema.json",
  "title": "StellaSora PersonalLocalMode Input Locator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestPath",
    "baseline",
    "sourceBoundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "manifestPath": {
      "$ref": "#/$defs/absoluteLocalPath"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "path"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "Absent",
            "Present"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "Absent"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "Present"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "$ref": "#/$defs/absoluteLocalPath"
              }
            }
          }
        }
      ]
    },
    "sourceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sources"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceRow"
          }
        }
      }
    }
  },
  "$defs": {
    "absoluteLocalPath": {
      "type": "string",
      "minLength": 3,
      "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\)"
    },
    "sourceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceKind",
        "rootPath"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sourceKind": {
          "enum": [
            "PcInstall",
            "PcPatchOrCache",
            "AndroidApk",
            "AndroidDataOrCache"
          ]
        },
        "rootPath": {
          "$ref": "#/$defs/absoluteLocalPath"
        }
      }
    }
  }
}
