{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stellagaia.dev/schemas/root-gate-summary.schema.json",
  "title": "StellaGaia Root Gate Summary",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "inputFingerprint",
    "toolVersions",
    "directGateSummaries",
    "directGateReports",
    "corpusSnapshotComplete",
    "structuredObjectCoverage",
    "originalAssetBatchCoverage",
    "stellaSora2AuthoringReady"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "inputFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolVersions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/toolVersion"
      }
    },
    "directGateSummaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "directGateReports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "corpusSnapshotComplete": {
      "type": "object",
      "required": [
        "value",
        "catalogedFileCount",
        "sourceFileCount",
        "catalogedBytes",
        "sourceBytes"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "boolean"
        },
        "catalogedFileCount": {
          "type": "integer",
          "minimum": 0
        },
        "sourceFileCount": {
          "type": "integer",
          "minimum": 0
        },
        "catalogedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sourceBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "structuredObjectCoverage": {
      "type": "object",
      "required": [
        "parsedContainerCount",
        "parsedContainerBytes",
        "opaqueOrFailedContainerCount",
        "opaqueOrFailedContainerBytes",
        "enumeratedObjectCount",
        "classifiedObjectCount",
        "unclassifiedObjectCount",
        "configurationCandidateCount",
        "configurationParsedCount"
      ],
      "additionalProperties": false,
      "properties": {
        "parsedContainerCount": {
          "type": "integer",
          "minimum": 0
        },
        "parsedContainerBytes": {
          "type": "integer",
          "minimum": 0
        },
        "opaqueOrFailedContainerCount": {
          "type": "integer",
          "minimum": 0
        },
        "opaqueOrFailedContainerBytes": {
          "type": "integer",
          "minimum": 0
        },
        "enumeratedObjectCount": {
          "type": "integer",
          "minimum": 0
        },
        "classifiedObjectCount": {
          "type": "integer",
          "minimum": 0
        },
        "unclassifiedObjectCount": {
          "type": "integer",
          "minimum": 0
        },
        "configurationCandidateCount": {
          "type": "integer",
          "minimum": 0
        },
        "configurationParsedCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "originalAssetBatchCoverage": {
      "type": "object",
      "required": [
        "reusableFamilyCount",
        "totalFamilyCount",
        "reusableMemberCount",
        "totalMemberCount",
        "reusableBytes",
        "totalBytes"
      ],
      "additionalProperties": false,
      "properties": {
        "reusableFamilyCount": {
          "type": "integer",
          "minimum": 0
        },
        "totalFamilyCount": {
          "type": "integer",
          "minimum": 0
        },
        "reusableMemberCount": {
          "type": "integer",
          "minimum": 0
        },
        "totalMemberCount": {
          "type": "integer",
          "minimum": 0
        },
        "reusableBytes": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stellaSora2AuthoringReady": {
      "type": "object",
      "required": [
        "value",
        "requiredCapabilities",
        "satisfiedCapabilities",
        "isolatedFailedMemberCount"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "boolean"
        },
        "requiredCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "satisfiedCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "isolatedFailedMemberCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![\\\\/]).+"
    },
    "toolVersion": {
      "type": "object",
      "required": [
        "toolName",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "toolName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
